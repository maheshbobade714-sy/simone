<%- include('header.ejs'); %>

   <section class="section" id="resume">
      <div class="container">
        <div class="section-head">
          <div class="section-bg-title">Summary</div>
          <h2 class="section-title">Resume</h2>
        </div>
        <div class="resume-cols">
          <div>
          
<div>
    <h3>My Education</h3>

    <% for (var i = 0; i < education.length; i++) { %>

        <article class="timeline-card">

            <span class="badge">
                <%= education[i].e_year %>
            </span>

            <h4>
                <%= education[i].e_title %>
            </h4>

            <div class="place">
                <%= education[i].e_place %>
            </div>

            <p>
                <%= education[i].e_desc %>
            </p>

        </article>

    <% } %>

</div> 
          <div>
    <h3>My Experience</h3>

    <% for (var i=0;i<experience.length;i++) { %>

        <article class="timeline-card">

            <span class="badge">
                <%= experience[i].e_year %>
            </span>

            <h4>
                <%= experience[i].e_title %>
            </h4>

            <div class="place">
                <%= experience[i].e_place %>
            </div>

            <p>
                <%= experience[i].e_desc %>
            </p>

        </article>

    <% } %>

</div>
        </div>
        <div class="skills">

    <h3>My Skills</h3>

    <div class="skills-grid">

        <% for(var i = 0; i < skill.length; i++) { %>

            <div class="skill">

                <header>
                    <span>
                        <%= skill[i].s_title %>
                    </span>

                    <span>
                        <%= skill[i].s_percentage %>%
                    </span>
                </header>

                <div class="bar">
                    <span style="width: <%= skill[i].s_percentage %>%"></span>
                </div>

            </div>

        <% } %>

    </div>

</div>
          </div>
        </div>
      </div> 
    </section>

<%- include('footer.ejs'); %>
