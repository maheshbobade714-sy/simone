<%- include('header.ejs'); %>

 <section class="section section--alt" id="contact">
      <div class="container">
        <div class="section-head">
          <div class="section-bg-title">Contact</div>
          <h2 class="section-title">Get in Touch</h2>
        </div>
        <div class="contact-grid contact">
          <div>
            <h3>Address</h3>
            <p>4th Floor, Plot No.22, 145 Murphy Canyon Rd. San Diego CA 2028</p>
            <ul class="contact-list">
              <li>(060) 444 434 444</li>
              <li>(060) 555 545 555</li>
              <li><a href="mailto:chat@simone.com">chat@simone.com</a></li>
            </ul>
            <h3>Follow Me</h3>
            <div class="social-row">
              <a href="#" aria-label="Dribbble">Dr</a>
              <a href="#" aria-label="Twitter">Tw</a>
              <a href="#" aria-label="Facebook">Fb</a>
              <a href="#" aria-label="GitHub">Gh</a>
            </div>
          </div>
          <div>
            <h3>Send us a note</h3>
            <form class="form">
              <div class="form-row">
                <input type="text" name="name" placeholder="Name" required />
                <input type="email" name="email" placeholder="Email" required />
              </div>
              <textarea name="message" placeholder="Tell us more about your needs........" required></textarea>
              <button class="btn btn--accent" type="submit">Send Message</button>
            </form>
          </div>
        </div>
      </div>
    </section>

<%- include('footer.ejs'); %>
