<%- include('header.ejs'); %>

      <div class="main">
        <header class="topbar">
          <h2>Add Services Record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Service Form</h3>

            <form class="form" action="/admin/service_save" method="post">
              <div class="row">
                <div class="field">
                  <label for="name">Service Icon</label>
                  <input id="name" type="text" name="s_icons" placeholder="fa fa-icons" />
                </div>
                <div class="field">
                  <label for="text">Service Title</label>
                  <input id="text" type="text" name="s_title" placeholder="title...." />
                </div>
              </div>

              <div class="field">
                <label for="notes">Service Description</label>
                <textarea id="notes" name="s_desc" placeholder="Short note..."></textarea>
              </div>

              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>

<%- include('footer.ejs'); %>

