<%- include('header.ejs'); %>

      <div class="main">
        <header class="topbar">
          <h2>Work table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>All Work</h3>
            <p class="hint">Sample rows for layout only.</p>

            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Img</th>
                  <th>Title</th>
                  <th>Desc</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0;i<data.length;i++){ %>
                <tr>
                  <td><%= i+1 %></td>
                  <td>
                    <img src="/img/<%= data[i].w_img %>" height="100px" />
                  </td>
                  <td><%= data[i].w_title %></td>
                  <td><%= data[i].w_desc %></td>
                  <td>
                    <span class="badge badge-ok">Delete</span>
                    <span class="badge badge-ok">Edit</span>

                </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>

<%- include('footer.ejs'); %>

