<%- include('header.ejs'); %>

<div class="main">

    <header class="topbar">
        <h2>Client Table</h2>
        <div class="user">Welcome, Admin</div>
    </header>

    <section class="content">

        <div class="panel">

            <h3>All Clients</h3>

            <table>

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client Name</th>
                        <th>Description</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    <% for(var i = 0; i < client.length; i++) { %>

                    <tr>

                        <td><%= i + 1 %></td>

                        <td>
                            <%= client[i].c_name %>
                        </td>

                        <td>
                            <%= client[i].c_desc %>
                        </td>

                        <td>
                            <span class="badge badge-ok">
                                Active
                            </span>
                        </td>

                    </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </section>

</div>

<%- include('footer.ejs'); %>